    "@types/geojson": "^7946.0.13",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vue-tsc": "^1.8.27",
    "autoprefixer": "^10.4.16",
