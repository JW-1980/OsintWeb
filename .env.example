# OsintWeb Environment Configuration
# MySQL 8.0+ Stack - Simplified Hosting

# Application
APP_NAME="OsintWeb"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database - MySQL 8.0+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osintweb
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Cache - File or Database (no Redis required)
# Development: file
# Production: database
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue - Database (no Redis required)
QUEUE_CONNECTION=database

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@osintweb.com"
MAIL_FROM_NAME="${APP_NAME}"

# Search - Meilisearch (optional, can use MySQL full-text)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=your_meilisearch_master_key

# Alternative: Use MySQL full-text search
# SCOUT_DRIVER=database

# Broadcasting (optional)
BROADCAST_DRIVER=log

# Filesystem
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# OSINT Settings
OSINT_DEFAULT_MAP_CENTER_LAT=48.8566
OSINT_DEFAULT_MAP_CENTER_LNG=2.3522
OSINT_DEFAULT_MAP_ZOOM=6

# Satellite Imagery (optional integrations)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
PLANET_API_KEY=

# Social Media Monitoring (optional)
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=

# External Services
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Weather Data APIs (for chronolocation/shadow analysis)
WEATHER_DEFAULT_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_TIER=free
VISUALCROSSING_API_KEY=
VISUALCROSSING_TIER=free
WEATHER_CACHE_ENABLED=true

# OpenRouter.ai (for OCR, Document Analysis, Translation)
# Get your free API key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120
OPENROUTER_RATE_LIMIT_ENABLED=true
OPENROUTER_RATE_LIMIT_RPM=20
OPENROUTER_CACHE_ENABLED=true
OPENROUTER_LOGGING_ENABLED=true

# OpenRouter Models (free models)
OPENROUTER_MODEL_CHAT=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_MODEL_TRANSLATION=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_NER=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_CLASSIFICATION=mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL_LANG_DETECT=meta-llama/llama-3.2-3b-instruct:free

# OCR Configuration (Tesseract)
OCR_USE_TESSERACT=true
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANGUAGES=eng+ukr+rus
OCR_AI_FALLBACK=true
OCR_AI_FALLBACK_THRESHOLD=60

# Document Processing
DOCUMENT_MAX_FILE_SIZE=20971520
DOCUMENT_MAX_PAGES=50

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# AWS (if using S3 for media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Evidence Preservation System
EVIDENCE_USER_AGENT="Mozilla/5.0 (compatible; OsintWeb Evidence Archiver/1.0)"
EVIDENCE_MAX_RETRIES=3
EVIDENCE_STORAGE_DISK=evidence
EVIDENCE_MAX_FILE_SIZE=104857600
EVIDENCE_RETENTION_DAYS=
EVIDENCE_CLEANUP_ENABLED=false
EVIDENCE_FETCH_TIMEOUT=30
EVIDENCE_VERIFY_SSL=true

# Evidence - IPFS (optional, for decentralized storage)
EVIDENCE_IPFS_ENABLED=false
EVIDENCE_IPFS_PROVIDER=pinata
EVIDENCE_IPFS_GATEWAY=https://ipfs.io/ipfs/
PINATA_API_KEY=
PINATA_API_SECRET=
INFURA_IPFS_PROJECT_ID=
INFURA_IPFS_PROJECT_SECRET=

# Evidence - Wayback Machine
EVIDENCE_WAYBACK_ENABLED=true
EVIDENCE_WAYBACK_TIMEOUT=60

# Evidence - Screenshot Capture (optional)
# Supported: none, screenshotone, browserless
EVIDENCE_SCREENSHOT_SERVICE=none
SCREENSHOTONE_API_KEY=
BROWSERLESS_URL=
BROWSERLESS_TOKEN=

# Evidence - Rate Limiting
EVIDENCE_RATE_LIMIT_HOUR=100
EVIDENCE_RATE_LIMIT_DAY=500

# Vite (frontend build)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Health Check Configuration
# Thresholds for warning/critical alerts
HEALTH_DB_RESPONSE_THRESHOLD=100
HEALTH_DISK_WARNING_PERCENT=80
HEALTH_DISK_CRITICAL_PERCENT=95
HEALTH_STUCK_JOBS_MINUTES=60
HEALTH_FAILED_JOBS_WARNING=10
HEALTH_SCHEDULER_WARNING_MINUTES=5
HEALTH_MEMORY_WARNING_PERCENT=80
HEALTH_MEMORY_CRITICAL_PERCENT=95
HEALTH_EXTERNAL_TIMEOUT=5

# Health Check Caching
HEALTH_QUICK_CACHE_TTL=30

# Health Check Logging
HEALTH_LOGGING_ENABLED=true
HEALTH_LOG_FAILURES_ONLY=false
HEALTH_LOG_RETENTION_DAYS=30

# Health Check Rate Limiting
HEALTH_RATE_LIMIT_PUBLIC=60
HEALTH_RATE_LIMIT_AUTHENTICATED=120
HEALTH_RATE_LIMIT_METRICS=30

# Health Check Alerting (optional)
HEALTH_ALERTING_ENABLED=false
HEALTH_ALERT_CHANNELS=log
HEALTH_ALERT_MIN_SEVERITY=unhealthy
HEALTH_ALERT_COOLDOWN=15
HEALTH_SLACK_WEBHOOK=
HEALTH_ALERT_EMAILS=
