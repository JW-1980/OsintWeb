# OsintWeb Environment Configuration
# MySQL 8.0+ Stack - Simplified Hosting

# Application
APP_NAME="OsintWeb"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database - MySQL 8.0+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osintweb
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Cache - File or Database (no Redis required)
# Development: file
# Production: database
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue - Database (no Redis required)
QUEUE_CONNECTION=database

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@osintweb.com"
MAIL_FROM_NAME="${APP_NAME}"

# Search - Meilisearch (optional, can use MySQL full-text)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=your_meilisearch_master_key

# Alternative: Use MySQL full-text search
# SCOUT_DRIVER=database

# Broadcasting (optional)
BROADCAST_DRIVER=log

# Filesystem
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# OSINT Settings
OSINT_DEFAULT_MAP_CENTER_LAT=48.8566
OSINT_DEFAULT_MAP_CENTER_LNG=2.3522
OSINT_DEFAULT_MAP_ZOOM=6

# Satellite Imagery (optional integrations)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
PLANET_API_KEY=

# Social Media Monitoring (optional)
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=

# External Services
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Weather Data APIs (for chronolocation/shadow analysis)
WEATHER_DEFAULT_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_TIER=free
VISUALCROSSING_API_KEY=
VISUALCROSSING_TIER=free
WEATHER_CACHE_ENABLED=true

# =============================================================================
# AI INFERENCE PROVIDERS (All Free Tier)
# =============================================================================
# OsintWeb supports multiple AI inference providers with free tiers.
# All providers use OpenAI-compatible endpoints for seamless switching.
# Configure one or more providers - the system will automatically fallback.

# Default Provider (openrouter, gemini, groq, cerebras, mistral)
INFERENCE_DEFAULT_PROVIDER=openrouter

# Global Inference Settings
INFERENCE_TIMEOUT=120
INFERENCE_RATE_LIMIT_ENABLED=true
INFERENCE_CACHE_ENABLED=true
INFERENCE_LOGGING_ENABLED=true

# -----------------------------------------------------------------------------
# OpenRouter - Multi-Model Gateway
# -----------------------------------------------------------------------------
# Website: https://openrouter.ai/
# Free tier: Access to multiple free models (Llama, Mistral, Gemma, etc.)
# Sign up: https://openrouter.ai/keys
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_RATE_LIMIT_RPM=20
OPENROUTER_CACHE_ENABLED=true
OPENROUTER_LOGGING_ENABLED=true

# OpenRouter Models (free models)
OPENROUTER_MODEL_CHAT=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_MODEL_TRANSLATION=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_NER=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_CLASSIFICATION=mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL_LANG_DETECT=meta-llama/llama-3.2-3b-instruct:free

# -----------------------------------------------------------------------------
# Google Gemini - AI Studio
# -----------------------------------------------------------------------------
# Website: https://ai.google.dev/
# Free tier: 15 RPM, 1M tokens/min, 1500 requests/day
# Features: 1 MILLION token context window, multimodal support
# Sign up: https://aistudio.google.com/app/apikey
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_RATE_LIMIT_RPM=15
GEMINI_RATE_LIMIT_RPD=1500

# Gemini Models (all free)
GEMINI_MODEL_CHAT=gemini-2.0-flash-exp
GEMINI_MODEL_VISION=gemini-2.0-flash-exp
GEMINI_MODEL_TRANSLATION=gemini-2.0-flash-exp
GEMINI_MODEL_NER=gemini-2.0-flash-exp
GEMINI_MODEL_CLASSIFICATION=gemini-2.0-flash-exp
GEMINI_MODEL_LANG_DETECT=gemini-2.0-flash-exp

# -----------------------------------------------------------------------------
# Groq - Ultra-Fast LPU Inference
# -----------------------------------------------------------------------------
# Website: https://console.groq.com/
# Free tier: 30 RPM, 14,400 requests/day, ultra-fast inference
# Features: Fastest inference speed, Llama 3.3 70B, Mixtral models
# Sign up: https://console.groq.com/keys
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_RATE_LIMIT_RPM=30
GROQ_RATE_LIMIT_RPD=14400

# Groq Models (all free)
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=llama-3.2-90b-vision-preview
GROQ_MODEL_TRANSLATION=llama-3.3-70b-versatile
GROQ_MODEL_NER=llama-3.1-8b-instant
GROQ_MODEL_CLASSIFICATION=llama-3.1-8b-instant
GROQ_MODEL_LANG_DETECT=llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# Cerebras - Fastest Inference
# -----------------------------------------------------------------------------
# Website: https://cloud.cerebras.ai/
# Free tier: 30 RPM, 60K tokens/min, 1 BILLION tokens/month
# Features: Fastest inference available, Llama 3.3 70B
# Sign up: https://cloud.cerebras.ai/
# Note: Does not support vision/image models
CEREBRAS_ENABLED=true
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_RATE_LIMIT_RPM=30
CEREBRAS_RATE_LIMIT_TPM=60000

# Cerebras Models (all free)
CEREBRAS_MODEL_CHAT=llama-3.3-70b
CEREBRAS_MODEL_TRANSLATION=llama-3.3-70b
CEREBRAS_MODEL_NER=llama-3.1-8b
CEREBRAS_MODEL_CLASSIFICATION=llama-3.1-8b
CEREBRAS_MODEL_LANG_DETECT=llama-3.1-8b

# -----------------------------------------------------------------------------
# Mistral AI - La Plateforme
# -----------------------------------------------------------------------------
# Website: https://console.mistral.ai/
# Free tier: Experimental tier with generous limits
# Features: European AI provider, strong multilingual support, Pixtral vision
# Sign up: https://console.mistral.ai/api-keys/
MISTRAL_ENABLED=true
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_RATE_LIMIT_RPM=60

# Mistral Models (free on experimental tier)
MISTRAL_MODEL_CHAT=mistral-small-latest
MISTRAL_MODEL_VISION=pixtral-12b-2409
MISTRAL_MODEL_TRANSLATION=mistral-small-latest
MISTRAL_MODEL_NER=mistral-small-latest
MISTRAL_MODEL_CLASSIFICATION=mistral-small-latest
MISTRAL_MODEL_LANG_DETECT=mistral-small-latest

# -----------------------------------------------------------------------------
# SambaNova - Ultra-Fast RDU Inference
# -----------------------------------------------------------------------------
# Website: https://cloud.sambanova.ai/
# Free tier: 10-30 RPM per model, no payment method required
# Features: Ultra-fast RDU hardware, DeepSeek R1/V3, Llama 3.3 405B
# Sign up: https://cloud.sambanova.ai/apis
SAMBANOVA_ENABLED=true
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_RATE_LIMIT_RPM=20

# SambaNova Models (all free)
SAMBANOVA_MODEL_CHAT=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_VISION=Llama-3.2-11B-Vision-Instruct
SAMBANOVA_MODEL_TRANSLATION=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_NER=Meta-Llama-3.1-8B-Instruct
SAMBANOVA_MODEL_CLASSIFICATION=Meta-Llama-3.1-8B-Instruct
SAMBANOVA_MODEL_LANG_DETECT=Meta-Llama-3.1-8B-Instruct

# -----------------------------------------------------------------------------
# GitHub Models - Azure AI Inference
# -----------------------------------------------------------------------------
# Website: https://github.com/marketplace/models
# Free tier: Free with any GitHub account (uses Personal Access Token)
# Features: GPT-4o, Llama, Mistral, Phi models via Azure
# Auth: Create a PAT at https://github.com/settings/tokens with models:read
GITHUB_MODELS_ENABLED=true
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_RATE_LIMIT_RPM=15
GITHUB_MODELS_RATE_LIMIT_RPD=150

# GitHub Models (free tier)
GITHUB_MODELS_MODEL_CHAT=Meta-Llama-3.1-70B-Instruct
GITHUB_MODELS_MODEL_VISION=Llama-3.2-11B-Vision-Instruct
GITHUB_MODELS_MODEL_TRANSLATION=Meta-Llama-3.1-70B-Instruct
GITHUB_MODELS_MODEL_NER=Meta-Llama-3.1-8B-Instruct
GITHUB_MODELS_MODEL_CLASSIFICATION=Mistral-small
GITHUB_MODELS_MODEL_LANG_DETECT=Meta-Llama-3.1-8B-Instruct

# -----------------------------------------------------------------------------
# Together AI - Open-Source Model Cloud
# -----------------------------------------------------------------------------
# Website: https://www.together.ai/
# Free tier: Free credits on signup, free model tier available
# Features: 200+ models, sub-100ms latency, fine-tuning
# Sign up: https://api.together.ai/
TOGETHER_ENABLED=true
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_RATE_LIMIT_RPM=60

# Together AI Models (free tier)
TOGETHER_MODEL_CHAT=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_MODEL_VISION=meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo
TOGETHER_MODEL_TRANSLATION=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_MODEL_NER=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
TOGETHER_MODEL_CLASSIFICATION=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
TOGETHER_MODEL_LANG_DETECT=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# -----------------------------------------------------------------------------
# Novita AI - Multi-Model Platform
# -----------------------------------------------------------------------------
# Website: https://novita.ai/
# Free tier: Several free models (Llama, Qwen, GLM)
# Features: 200+ models, 300 tokens/sec, global CDN
# Sign up: https://novita.ai/
# Note: Free vision models not currently available
NOVITA_ENABLED=true
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
NOVITA_RATE_LIMIT_RPM=60

# Novita AI Models (free)
NOVITA_MODEL_CHAT=meta-llama/llama-3.1-70b-instruct
NOVITA_MODEL_TRANSLATION=meta-llama/llama-3.1-70b-instruct
NOVITA_MODEL_NER=qwen/qwen-2.5-7b-instruct
NOVITA_MODEL_CLASSIFICATION=qwen/qwen-2.5-7b-instruct
NOVITA_MODEL_LANG_DETECT=qwen/qwen-2.5-7b-instruct

# -----------------------------------------------------------------------------
# Task-Specific Provider Overrides (Optional)
# -----------------------------------------------------------------------------
# Override the default provider for specific tasks
# Leave empty to use the default provider
INFERENCE_VISION_PROVIDER=
INFERENCE_TRANSLATION_PROVIDER=
INFERENCE_CLASSIFICATION_PROVIDER=
INFERENCE_LANGDETECT_PROVIDER=

# OCR Configuration (Tesseract)
OCR_USE_TESSERACT=true
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANGUAGES=eng+ukr+rus
OCR_AI_FALLBACK=true
OCR_AI_FALLBACK_THRESHOLD=60

# Document Processing
DOCUMENT_MAX_FILE_SIZE=20971520
DOCUMENT_MAX_PAGES=50

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# AWS (if using S3 for media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Evidence Preservation System
EVIDENCE_USER_AGENT="Mozilla/5.0 (compatible; OsintWeb Evidence Archiver/1.0)"
EVIDENCE_MAX_RETRIES=3
EVIDENCE_STORAGE_DISK=evidence
EVIDENCE_MAX_FILE_SIZE=104857600
EVIDENCE_RETENTION_DAYS=
EVIDENCE_CLEANUP_ENABLED=false
EVIDENCE_FETCH_TIMEOUT=30
EVIDENCE_VERIFY_SSL=true

# Evidence - IPFS (optional, for decentralized storage)
EVIDENCE_IPFS_ENABLED=false
EVIDENCE_IPFS_PROVIDER=pinata
EVIDENCE_IPFS_GATEWAY=https://ipfs.io/ipfs/
PINATA_API_KEY=
PINATA_API_SECRET=
INFURA_IPFS_PROJECT_ID=
INFURA_IPFS_PROJECT_SECRET=

# Evidence - Wayback Machine
EVIDENCE_WAYBACK_ENABLED=true
EVIDENCE_WAYBACK_TIMEOUT=60

# Evidence - Screenshot Capture (optional)
# Supported: none, screenshotone, browserless
EVIDENCE_SCREENSHOT_SERVICE=none
SCREENSHOTONE_API_KEY=
BROWSERLESS_URL=
BROWSERLESS_TOKEN=

# Evidence - Rate Limiting
EVIDENCE_RATE_LIMIT_HOUR=100
EVIDENCE_RATE_LIMIT_DAY=500

# Vite (frontend build)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Health Check Configuration
# Thresholds for warning/critical alerts
HEALTH_DB_RESPONSE_THRESHOLD=100
HEALTH_DISK_WARNING_PERCENT=80
HEALTH_DISK_CRITICAL_PERCENT=95
HEALTH_STUCK_JOBS_MINUTES=60
HEALTH_FAILED_JOBS_WARNING=10
HEALTH_SCHEDULER_WARNING_MINUTES=5
HEALTH_MEMORY_WARNING_PERCENT=80
HEALTH_MEMORY_CRITICAL_PERCENT=95
HEALTH_EXTERNAL_TIMEOUT=5

# Health Check Caching
HEALTH_QUICK_CACHE_TTL=30

# Health Check Logging
HEALTH_LOGGING_ENABLED=true
HEALTH_LOG_FAILURES_ONLY=false
HEALTH_LOG_RETENTION_DAYS=30

# Health Check Rate Limiting
HEALTH_RATE_LIMIT_PUBLIC=60
HEALTH_RATE_LIMIT_AUTHENTICATED=120
HEALTH_RATE_LIMIT_METRICS=30

# Health Check Alerting (optional)
HEALTH_ALERTING_ENABLED=false
HEALTH_ALERT_CHANNELS=log
HEALTH_ALERT_MIN_SEVERITY=unhealthy
HEALTH_ALERT_COOLDOWN=15
HEALTH_SLACK_WEBHOOK=
HEALTH_ALERT_EMAILS=
