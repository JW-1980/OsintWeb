# OsintWeb Environment Configuration
# MySQL 8.0+ Stack - Simplified Hosting

# Application
APP_NAME="OsintWeb"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database - MySQL 8.0+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osintweb
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Cache - File or Database (no Redis required)
# Development: file
# Production: database
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue - Database (no Redis required)
QUEUE_CONNECTION=database

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@osintweb.com"
MAIL_FROM_NAME="${APP_NAME}"

# Search - Meilisearch (optional, can use MySQL full-text)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=your_meilisearch_master_key

# Alternative: Use MySQL full-text search
# SCOUT_DRIVER=database

# Broadcasting (optional)
BROADCAST_DRIVER=log

# Filesystem
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# OSINT Settings
OSINT_DEFAULT_MAP_CENTER_LAT=48.8566
OSINT_DEFAULT_MAP_CENTER_LNG=2.3522
OSINT_DEFAULT_MAP_ZOOM=6

# Satellite Imagery (optional integrations)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
PLANET_API_KEY=

# Social Media Monitoring (optional)
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=

# External Services
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# AWS (if using S3 for media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite (frontend build)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
